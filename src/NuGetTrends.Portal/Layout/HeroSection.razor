<MudContainer MaxWidth="MaxWidth.Large">
    <MudGrid Justify="Justify.FlexStart">
        <MudItem xs="12" md="4" class="text-center m-10">
            <MudPaper Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.ShowChart" Size="Size.Large" Color="Color.Primary"/>
                <MudText Typo="Typo.h4" Align="Align.Center" Class="m-5 font-weight-bold">Compare Package Downloads</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary" Align="Align.Center">
                    Explore historical download trends for NuGet packages over time.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4" class="text-center px-4">
            <MudPaper Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.TrackChanges" Size="Size.Large" Color="Color.Primary"/>
                <MudText Typo="Typo.h4" Align="Align.Center" Class="m-5 font-weight-bold">Framework Adoption Insights</MudText>
                <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary">
                    Discover how many packages target specific frameworks and track adoption trends.
                </MudText>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" md="4" class="text-center px-4">
            <MudPaper Elevation="0">
                <MudIcon Icon="@Icons.Material.Filled.AltRoute" Size="Size.Large" Color="Color.Primary"/>
                <MudText Typo="Typo.h4" Align="Align.Center" Class="m-5 font-weight-bold">Decide with Confidence</MudText>
                <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary">
                    Make informed decisions about packages and frameworks using real-world data.
                </MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>
